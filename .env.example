# ── App ────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=VocalIQ
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth Service (Node.js) — Port 4000 ─────────────────
NEXT_PUBLIC_AUTH_API_URL=http://localhost:4000

# ── AI Backend (Python/FastAPI) — Port 8000 ────────────
NEXT_PUBLIC_AI_API_URL=http://localhost:8000

# ── Supabase (DB + Storage) ────────────────────────────
# Dashboard: https://supabase.com/dashboard/project/<YOUR_PROJECT_ID>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<YOUR_PROJECT_ID>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...           # anon / public key
SUPABASE_SERVICE_ROLE_KEY=eyJ...               # service_role key (SECRET — never expose)

# ── Optional: Cloud AI Providers & Integrations ────────
# (Python ai-service yahi keys use karta hai — frontend directly nahi)
OPENAI_API_KEY=sk-...
DEEPGRAM_API_KEY=                              # cloud STT (optional — local whisper bhi hai)
ELEVENLABS_API_KEY=                            # cloud TTS (optional — edge-tts free hai)

# ── Optional: Stripe & LiveKit ────────────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_... # Optional client-side Stripe checkout
NEXT_PUBLIC_LIVEKIT_URL=ws://localhost:7880    # Optional WebRTC room direct connection

